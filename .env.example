# ==============================================================================
# WABulk - Environment Configuration Example
# ==============================================================================

# Database: PostgreSQL connection URL (Neon, Supabase, Render, Local)
DATABASE_URL="postgresql://user:password@localhost:5432/wabulk?schema=public"

# Redis: Optional. Redis connection string for BullMQ queue processing.
# If omitted or unconnectable, WABulk automatically switches to internal fallback queue runner.
REDIS_URL="redis://localhost:6379"

# Authentication & Sessions
# Generate with `openssl rand -base64 32`
AUTH_SECRET="your_strong_auth_secret_here"
AUTH_COOKIE_NAME="wabulk_session"

# Official Meta WhatsApp Cloud API (Graph API v20.0)
# Leave empty to enable Safe Demo Mode (all sends and webhooks simulated safely)
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_waba_id"
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_token"

# Rate Limiting & Messaging Speed
MESSAGES_PER_MINUTE=60
MAX_CONCURRENT_JOBS=5
RETRY_LIMIT=3

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WABulk"
NEXT_PUBLIC_DEMO_MODE=true
