    "deploy": "prisma db push && tsx prisma/seed.ts && prisma generate && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.17",
    "lucide-react": "^0.475.0",
    "next": "15.1.7",
    "papaparse": "^5.5.2",
    "postcss": "^8.5.2",
    "prisma": "^6.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "autoprefixer": "^10.4.20",
    "@types/bcryptjs": "^2.4.6",
