{
  "name": "wabulk",
  "version": "1.0.0",
  "private": true,
  "description": "WABulk - Simple. Powerful. Official WhatsApp Bulk Messaging Web Application",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
